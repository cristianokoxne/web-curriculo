---
import BaseLayout from '../components/BaseLayout.astro';
import Localized from '../components/Localized.astro';
---
<BaseLayout title="Contato | Cristiano Koxne" page="contact">
  <main class="contact-page">
    <section class="contact-hero">
      <div class="contact-stamp">◌<span><Localized pt="ABERTO A NOVOS PROJETOS" en="OPEN TO NEW PROJECTS" /></span></div>
      <p class="eyebrow"><Localized pt="CONTATO · VAMOS CONVERSAR" en="CONTACT · LET'S TALK" /></p>
      <h1><Localized pt="Tem um projeto em mente?" en="Have a project in mind?" /></h1>
      <p class="contact-intro"><Localized pt="Estou disponível para conversar sobre produtos digitais, engenharia de software e automações que realmente resolvem problemas." en="I am available to talk about digital products, software engineering, and automations that solve real problems." /></p>
      <a class="email-cta" href="mailto:cristiano_koxne@outlook.com">✉ <Localized pt="Enviar um e-mail" en="Send an email" /> ↗</a>
    </section>
    <section class="contact-networks"><p class="section-kicker"><Localized pt="Ou me encontre por aqui" en="Or find me here" /></p><div class="network-links"><a href="https://www.linkedin.com/in/cristiano-koxne-8866511b9/" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.3 3.5a2.3 2.3 0 1 1 0 4.6 2.3 2.3 0 0 1 0-4.6ZM3.3 9.8h4v10.7h-4V9.8Zm6.5 0h3.8v1.5h.1c.5-1 1.8-2 3.8-2 4.1 0 4.8 2.7 4.8 6.2v7h-4v-6.2c0-1.5 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3v6.3h-4V9.8Z" fill="currentColor"/></svg> LinkedIn <span>↗</span></a><a href="https://github.com/cristianokoxne" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.4-1.1.7-1.3-2.3-.3-4.7-1.2-4.7-5.2 0-1.2.4-2.1 1.1-2.9-.1-.3-.5-1.3.1-2.8 0 0 .9-.3 2.9 1.1a10 10 0 0 1 5.3 0c2-1.4 2.9-1.1 2.9-1.1.6 1.5.2 2.5.1 2.8.7.8 1.1 1.7 1.1 2.9 0 4-2.4 4.9-4.7 5.2.4.3.7 1 .7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z" fill="currentColor"/></svg> GitHub <span>↗</span></a></div></section>
  </main>
</BaseLayout>
