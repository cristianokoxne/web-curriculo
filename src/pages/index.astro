---
import BaseLayout from '../components/BaseLayout.astro';
import Localized from '../components/Localized.astro';
import SectionIcon from '../components/SectionIcon.astro';
import { translations } from '../translations.js';

const pt = translations.pt;
const en = translations.en;
const products = [
  { name: 'Gym Wave', icon: '/images/product-gymwave.png', url: 'https://www.gymwave.com.br/', pt: 'Uma plataforma modular para academias que centraliza alunos, acesso facial, treino, financeiro, automações e inteligência operacional.', en: 'A modular platform for gyms that centralizes students, facial access, training, finance, automation, and operational intelligence.' },
  { name: 'UsaAí', icon: '/images/product-usaai.png', url: 'https://www.usaai.com.br/', pt: 'Conecta a operação do Chatcenter Fortics aos números de WhatsApp, tornando a comunicação da equipe mais fluida e integrada.', en: 'Connects Chatcenter Fortics operations to WhatsApp numbers, making team communication more fluid and integrated.' },
  { name: 'Fast Sheet API', icon: '/images/product-fastsheet.svg', url: 'https://www.fastsheetapi.com/', pt: 'Uma forma simples e rápida de disponibilizar dados de planilhas para o mundo por meio de uma API.', en: 'A simple, fast way to make spreadsheet data available to the world through an API.' },
  { name: 'OmniBridge', icon: '/images/product-omnibridge.svg', url: 'https://omnibridge.com.br/', pt: 'Uma página de bio elegante para Instagram e TikTok, com links estratégicos, tema personalizável e métricas de cliques.', en: 'An elegant bio page for Instagram and TikTok, with strategic links, customizable themes, and click metrics.' },
];
---
<BaseLayout page="home">
  <main class="resume-page">
    <header class="header hero">
      <div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div>
      <div class="profile-frame" title="Foto de Cristiano Koxne"><div class="profile-ring"></div><img src="/images/foto.png" alt="Cristiano Koxne" /><span class="profile-label"><Localized pt="DISPONÍVEL PARA PROJETOS" en="AVAILABLE FOR PROJECTS" /></span></div>
      <p class="eyebrow"><Localized pt="PORTFÓLIO · ENGENHARIA DE SOFTWARE" en="PORTFOLIO · SOFTWARE ENGINEERING" /></p>
      <h1>{pt.title}</h1><h2><Localized pt={pt.subtitle} en={en.subtitle} /></h2>
      <div class="contact"><p>✉ {pt.contact[0]}</p></div>
      <div class="socials" aria-label="Redes sociais">
        <a href="https://www.linkedin.com/in/cristiano-koxne-8866511b9/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.3 3.5a2.3 2.3 0 1 1 0 4.6 2.3 2.3 0 0 1 0-4.6ZM3.3 9.8h4v10.7h-4V9.8Zm6.5 0h3.8v1.5h.1c.5-1 1.8-2 3.8-2 4.1 0 4.8 2.7 4.8 6.2v7h-4v-6.2c0-1.5 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3v6.3h-4V9.8Z" fill="currentColor"/></svg></a>
        <a href="https://github.com/cristianokoxne" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.4-1.1.7-1.3-2.3-.3-4.7-1.2-4.7-5.2 0-1.2.4-2.1 1.1-2.9-.1-.3-.5-1.3.1-2.8 0 0 .9-.3 2.9 1.1a10 10 0 0 1 5.3 0c2-1.4 2.9-1.1 2.9-1.1.6 1.5.2 2.5.1 2.8.7.8 1.1 1.7 1.1 2.9 0 4-2.4 4.9-4.7 5.2.4.3.7 1 .7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z" fill="currentColor"/></svg></a>
        <a href="https://www.instagram.com/cristianokoxne/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg></a>
        <a href="https://twitter.com/cristianokoxne" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2.8h3.7l-8.1 9.3 9.5 9.1h-7.4l-5.8-5.6-4.9 5.6H2.2l8.6-9.8-9.1-8.7h7.6l5.3 5.1 4.3-5.1Zm-1.3 16.8h2L8.2 4.3H6.1l11.5 15.3Z" fill="currentColor"/></svg></a>
      </div>
      <a class="scroll-cue" href="#summary">↓ <Localized pt="Conheça meu trabalho" en="Explore my work" /></a>
    </header>
    <section id="summary" class="intro-section reveal"><div class="section-kicker"><SectionIcon name="profile" /> 01</div><h3><Localized pt={pt.summaryTitle} en={en.summaryTitle} /></h3><p><Localized pt={pt.summaryText} en={en.summaryText} /></p></section>
    <section class="reveal"><div class="section-kicker"><SectionIcon name="code" /> 02</div><h3><Localized pt={pt.skillsTitle} en={en.skillsTitle} /></h3><div class="skills-grid">{pt.skillsList.map((skill, index) => <div class="skill-item"><span class="skill-name"><Localized pt={skill} en={en.skillsList[index]} /></span></div>)}</div></section>
    <section class="reveal"><div class="section-kicker"><SectionIcon name="education" /> 03</div><h3><Localized pt={pt.educationTitle} en={en.educationTitle} /></h3>{pt.education.map((item, index) => <div class="education-item"><strong><Localized pt={item.period} en={en.education[index].period} /></strong><span class="education-degree"><Localized pt={item.degree} en={en.education[index].degree} /></span></div>)}</section>
    <section class="reveal"><div class="section-kicker"><SectionIcon name="work" /> 04</div><h3><Localized pt={pt.experienceTitle} en={en.experienceTitle} /></h3>{pt.experience.map((item, index) => <div class="exp-item"><h4><Localized pt={item.period} en={en.experience[index].period} /></h4><p><strong><Localized pt={item.role} en={en.experience[index].role} /></strong></p><ul>{item.details.map((detail, detailIndex) => <li><Localized pt={detail} en={en.experience[index].details[detailIndex]} /></li>)}</ul></div>)}</section>
    <section class="reveal products-section"><div class="section-kicker"><SectionIcon name="products" /> 05</div><h3><Localized pt="Produtos desenvolvidos" en="Products I built" /></h3><p><Localized pt="Soluções digitais pensadas para simplificar operações, conectar sistemas e colocar dados em movimento." en="Digital solutions designed to simplify operations, connect systems, and put data in motion." /></p><div class="products-grid">{products.map((product, index) => <article class="product-card"><div class="product-card-head"><span class="product-index">0{index + 1}</span><span class="product-logo"><img src={product.icon} alt="" /></span></div><h4>{product.name}</h4><p><Localized pt={product.pt} en={product.en} /></p><a href={product.url} target="_blank" rel="noreferrer"><Localized pt="Conhecer produto" en="Visit product" /> ↗</a></article>)}</div></section>
    <section class="reveal fun-section"><div class="section-kicker"><SectionIcon name="products" /> 06</div><h3><Localized pt="Construído por diversão" en="Built for fun" /></h3><p><Localized pt="Experimentos, protótipos e ideias que construo para testar tecnologias e aprender fazendo." en="Experiments, prototypes, and ideas I build to test technologies and learn by doing." /></p><div class="products-grid"><article class="product-card"><div class="product-card-head"><span class="product-index">01</span><span class="product-logo"><img src="/images/product-wakeupbro.png" alt="Logo Wake Up Bro" /></span></div><h4>Wake Up Bro!</h4><p><Localized pt="Um experimento de detecção facial no navegador que responde com vídeos motivacionais — construído como laboratório de desenvolvimento assistido por IA." en="A browser-based face-detection experiment that responds with motivational videos — built as a laboratory for AI-assisted development." /></p><a href="https://wake-up-bro.vercel.app/" target="_blank" rel="noreferrer"><Localized pt="Abrir experimento" en="Open experiment" /> ↗</a></article></div></section>
    <section class="reveal language-section"><div class="section-kicker"><SectionIcon name="language" /> 07</div><h3><Localized pt={pt.languagesTitle} en={en.languagesTitle} /></h3><ul>{pt.languagesList.map((language, index) => <li><Localized pt={language} en={en.languagesList[index]} /></li>)}</ul></section>
    <footer><p><Localized pt={pt.footer} en={en.footer} /></p><div class="footer-links"><a href="/">Home</a><a href="/blog">Blog</a><a href="/contato"><Localized pt="Contato" en="Contact" /></a></div></footer>
  </main>
</BaseLayout>
